# Servidor
NODE_ENV=development
PORT=3000

# Base de datos MongoDB
DATABASE_URL="mongodb://localhost:27017/sanuvia?directConnection=true"

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min32
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:4000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=800
RATE_LIMIT_SKIP_LOCALHOST=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40

# Admin (seed)
ADMIN_EMAIL=admin@sanuvia.app
ADMIN_PASSWORD=Admin123!ChangeMe

# Logging
LOG_LEVEL=info
LOG_DIR=logs

FRONTEND_URL=http://localhost:4000
